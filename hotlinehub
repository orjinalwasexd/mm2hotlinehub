                statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                statusLabel.Text = "Invalid key"
                _LS_TweenService:Create(inputStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, 80, 80)}):Play()
                task.spawn(shakeCard)
                task.delay(1.8, function()
                    if not keyAccepted then
                        statusLabel.Text = ""
                        _LS_TweenService:Create(inputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 40, 15)}):Play()
                    end
                end)
            end
        end

