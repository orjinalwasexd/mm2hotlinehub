                    _LS_TweenService:Create(loadBar, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 3)}):Play()
                    task.wait(0.7)
                    _LS_TweenService:Create(overlay, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
                    _LS_TweenService:Create(card, TweenInfo.new(0.3), {BackgroundTransparency = 1, Position = UDim2.new(0.5, -240, 0.4, -170)}):Play()
                    task.wait(0.42)
                    pcall(function() loadGui:Destroy() end)
                    if _G.HotlineActivate then _G.HotlineActivate() end
                end)
