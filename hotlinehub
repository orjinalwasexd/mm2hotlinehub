    startHiddenFling = function()
        stopHiddenFling()
        Config.HiddenFling = true
        isFlinging = true
        if hiddenFlingStatusRow then
            hiddenFlingStatusRow.SetValue("Aktif (Pos)")
            if hiddenFlingStatusRow.SetColor then hiddenFlingStatusRow.SetColor(Colors.AccentGreen) end
        end

        hiddenFlingThread = task.spawn(function()
            local hrp, c, vel, movel = nil, nil, nil, 0.1
            local lp = LocalPlayer

            while Config.HiddenFling do
                RunService.Heartbeat:Wait()
                if Config.HiddenFling then
                    while Config.HiddenFling and not (c and c.Parent and hrp and hrp.Parent) do
                        RunService.Heartbeat:Wait()
                        c = lp.Character
                        hrp = c and c:FindFirstChild("HumanoidRootPart")
                    end

                    if Config.HiddenFling and c and c.Parent and hrp and hrp.Parent then
                        local mult = Config.FlingMultiplier or 1000000
                        vel = hrp.Velocity
                        hrp.Velocity = vel * mult + Vector3.new(0, mult, 0)
                        RunService.RenderStepped:Wait()
                        if c and c.Parent and hrp and hrp.Parent then
                            hrp.Velocity = vel
                        end
                        RunService.Stepped:Wait()
                        if c and c.Parent and hrp and hrp.Parent then
                            hrp.Velocity = vel + Vector3.new(0, movel, 0)
                            movel = movel * -1
                        end
                    end
                end
            end
            isFlinging = false
        end)
    end

