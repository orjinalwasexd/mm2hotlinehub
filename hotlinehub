    local function v2UpdateCharacterParts()
        v2CharacterParts = {}
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                table.insert(v2CharacterParts, part)
            end
        end
    end

    local function v2RestoreCollision()
        for _, part in ipairs(v2CharacterParts) do
            if part and part.Parent then
                part.CanCollide = true
            end
        end
    end

    local function v2CleanupConnections()
        if v2HeartbeatConnection then pcall(function() v2HeartbeatConnection:Disconnect() end); v2HeartbeatConnection = nil end
        if v2NoclipConnection then pcall(function() v2NoclipConnection:Disconnect() end); v2NoclipConnection = nil end
        if v2CoinAddedConnection then pcall(function() v2CoinAddedConnection:Disconnect() end); v2CoinAddedConnection = nil end
        if v2CoinRemovedConnection then pcall(function() v2CoinRemovedConnection:Disconnect() end); v2CoinRemovedConnection = nil end
        if v2CoinsStartedConnection then pcall(function() v2CoinsStartedConnection:Disconnect() end); v2CoinsStartedConnection = nil end
        if v2CoinCollectedConnection then pcall(function() v2CoinCollectedConnection:Disconnect() end); v2CoinCollectedConnection = nil end
    end

    local function v2StopMovement()
        if v2LinearVelocity then
            v2LinearVelocity.VectorVelocity = Vector3.zero
            v2LinearVelocity.Enabled = false
        end
        local root = getRootPart(LocalPlayer.Character)
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    local function v2SetupVelocity()
        local root = getRootPart(LocalPlayer.Character)
        if not root then return end

        v2VelocityAttachment = root:FindFirstChild("FarmAttachment")
        if not v2VelocityAttachment then
            v2VelocityAttachment = Instance.new("Attachment")
            v2VelocityAttachment.Name = "FarmAttachment"
            v2VelocityAttachment.Parent = root
        end

        v2LinearVelocity = root:FindFirstChild("FarmLinearVelocity")
        if not v2LinearVelocity then
            v2LinearVelocity = Instance.new("LinearVelocity")
            v2LinearVelocity.Name = "FarmLinearVelocity"
            v2LinearVelocity.Attachment0 = v2VelocityAttachment
            v2LinearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
            v2LinearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
            v2LinearVelocity.VectorVelocity = Vector3.zero
            v2LinearVelocity.Enabled = false
            v2LinearVelocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
            v2LinearVelocity.MaxAxesForce = Vector3.new(100000, 100000, 100000)
            v2LinearVelocity.Parent = root
        end
    end

    local function v2RemoveVelocity()
        if v2LinearVelocity then pcall(function() v2LinearVelocity:Destroy() end); v2LinearVelocity = nil end
        if v2VelocityAttachment then pcall(function() v2VelocityAttachment:Destroy() end); v2VelocityAttachment = nil end
    end

    local function v2StartNoclip()
        if v2NoclipConnection then pcall(function() v2NoclipConnection:Disconnect() end) end
        v2UpdateCharacterParts()

        v2NoclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            local hum = getHumanoid(char)
            if char and Config.AutoFarmV2 and hum and hum.Health > 0 and not v2BagIsFull and not v2IsWaitingForCoins then
                for i = 1, #v2CharacterParts do
                    local part = v2CharacterParts[i]
                    if part and part.Parent and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)

        local hum = getHumanoid(LocalPlayer.Character)
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
        end
    end

    local function v2StopNoclip()
        if v2NoclipConnection then
            pcall(function() v2NoclipConnection:Disconnect() end)
            v2NoclipConnection = nil
        end
        v2RestoreCollision()
        local hum = getHumanoid(LocalPlayer.Character)
        if hum then
            hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        end
    end

    local function v2IsCoin(part)
        if not part or not part:IsA("BasePart") or v2BlacklistedCoins[part] then return false end
        local name = string.lower(part.Name)
        return name:find("coin") or name:find("cash") or name:find("money") or name:find("collect")
    end

    local function v2CheckGuiBagFull()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return false end

        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "HotlineMM2Gui" and gui.Name ~= "AutoFarmUI" then
                local container = gui:FindFirstChild("Container", true)
                if container then
                    for _, frame in ipairs(container:GetChildren()) do
                        if frame:IsA("Frame") and frame.Visible then
                            local fullIcon = frame:FindFirstChild("FullBagIcon", true)
                            local fullText = frame:FindFirstChild("Full", true)
                            if (fullIcon and fullIcon.Visible) or (fullText and fullText.Visible) then
                                return true
                            end
                        end
                    end
                end
            end
        end
        return false
    end

    local function v2TriggerBagFullReset()
        if v2BagIsFull then return end
        v2BagIsFull = true
        if v2StatusRow then v2StatusRow.SetValue("Dolu - Resetleniyor...") end
        v2StopMovement()
        v2StopNoclip()

        if Config.FarmV2AutoReset ~= false then
            task.wait(0.2)
            local hum = getHumanoid(LocalPlayer.Character)
            if hum and hum.Health > 0 then
                hum.Health = 0
            end
        end
    end

    local function v2TrackCoin(part)
        if v2IsCoin(part) then
            v2ActiveCoins[part] = true
        end
    end

    local function v2UntrackCoin(part)
        v2ActiveCoins[part] = nil
        if v2CurrentTarget == part then
            v2CurrentTarget = nil
        end
    end

    local function v2InitCoinListeners()
        v2ActiveCoins = {}
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v2IsCoin(v) then
                v2ActiveCoins[v] = true
            end
        end

        v2CoinAddedConnection = Workspace.DescendantAdded:Connect(v2TrackCoin)
        v2CoinRemovedConnection = Workspace.DescendantRemoving:Connect(v2UntrackCoin)

        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local gameplayRemotes = remotes and remotes:FindFirstChild("Gameplay")

        if gameplayRemotes then
            local coinsStartedRemote = gameplayRemotes:FindFirstChild("CoinsStarted")
            local coinCollectedRemote = gameplayRemotes:FindFirstChild("CoinCollected")

            if coinsStartedRemote then
                v2CoinsStartedConnection = coinsStartedRemote.OnClientEvent:Connect(function()
                    v2IsWaitingForCoins = true
                    v2StopMovement()
                    v2CurrentTarget = nil
                    v2ActiveCoins = {}
                    v2BlacklistedCoins = {}
                    v2NoCoinsStartTime = nil
                    v2BagIsFull = false
                    if v2StatusRow then v2StatusRow.SetValue("Coinler Bekleniyor...") end

                    task.wait(1.5)

                    for _, v in ipairs(Workspace:GetDescendants()) do
                        if v2IsCoin(v) then
                            v2ActiveCoins[v] = true
                        end
                    end

                    v2IsWaitingForCoins = false
                    if v2StatusRow then v2StatusRow.SetValue("Toplaniyor...") end
                end)
            end

            if coinCollectedRemote then
                v2CoinCollectedConnection = coinCollectedRemote.OnClientEvent:Connect(function(coinType, currentAmount, maxAmount)
                    local current = tonumber(currentAmount)
                    local max = tonumber(maxAmount)

                    if current and max then
                        if v2StatusRow then v2StatusRow.SetValue(string.format("Coin: %d / %d", current, max)) end
                        if current >= max then
                            v2TriggerBagFullReset()
                        end
                    end
                end)
            end
        end
    end

    local function v2StartTargetFinder()
        if v2TargetFinderThread then task.cancel(v2TargetFinderThread); v2TargetFinderThread = nil end

        v2TargetFinderThread = task.spawn(function()
            while Config.AutoFarmV2 do
                task.wait(0.1)

                if Config.AutoFarmV2 and not v2BagIsFull and v2CheckGuiBagFull() then
                    v2TriggerBagFullReset()
                end

                local root = getRootPart(LocalPlayer.Character)
                if Config.AutoFarmV2 and not v2BagIsFull and not v2IsWaitingForCoins and root then
                    local rootPos = root.Position
                    local nearest = nil
                    local nearestDist = 1000 + 1

                    for coin, _ in pairs(v2ActiveCoins) do
                        if coin and coin.Parent and not v2BlacklistedCoins[coin] then
                            local dist = (coin.Position - rootPos).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearest = coin
                            end
                        else
                            v2ActiveCoins[coin] = nil
                        end
                    end

                    if nearest and not nearest:FindFirstChild("CoinVisual") then
                        v2ActiveCoins[nearest] = nil
                        nearest = nil
                    end

                    v2CurrentTarget = nearest
                end
            end
        end)
    end

    local function v2StartMovementEngine()
        v2CleanupConnections()
        v2SetupVelocity()
        v2InitCoinListeners()
        v2NoCoinsStartTime = nil

        if Config.AutoFarmV2 and not v2BagIsFull then v2StartNoclip() end

        v2HeartbeatConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local root = getRootPart(char)
            local hum = getHumanoid(char)

            if not Config.AutoFarmV2 or v2BagIsFull or v2IsWaitingForCoins or not root or not root.Parent or not hum or hum.Health <= 0 then
                v2StopMovement()
                return
            end

            local speed = Config.FarmV2Speed or 23

            if v2CurrentTarget and v2CurrentTarget.Parent and not v2BlacklistedCoins[v2CurrentTarget] then
                v2NoCoinsStartTime = nil
                local targetPos = v2CurrentTarget.Position
                local rootPos = root.Position
                local dist = (targetPos - rootPos).Magnitude

                if dist <= 1.5 then
                    root.CFrame = CFrame.new(targetPos)
                    v2StopMovement()

                    v2HasCollectedThisLife = true
                    v2BlacklistedCoins[v2CurrentTarget] = true
                    v2ActiveCoins[v2CurrentTarget] = nil
                    v2CurrentTarget = nil
                else
                    if v2LinearVelocity then
                        v2LinearVelocity.Enabled = true
                        v2LinearVelocity.VectorVelocity = (targetPos - rootPos).Unit * speed
                    end
                end
            else
                v2StopMovement()

                if v2HasCollectedThisLife then
