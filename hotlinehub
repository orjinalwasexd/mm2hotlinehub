        local root = getRootPart(LocalPlayer.Character)
        if not tRoot or not root then return end

        local wasActive = Config.HiddenFling
        if not wasActive then startHiddenFling() end

        SendNotification("Fling", targetPlayer.Name .. " hedefine yaklasiliyor...", 2)
        local startTime = tick()
        while tick() - startTime < 1.5 do
            if not targetPlayer or not targetPlayer.Character or not tRoot.Parent or not root.Parent then break end
            root.CFrame = tRoot.CFrame * CFrame.new(0, 0.2, 0)
            RunService.Heartbeat:Wait()
        end

        if not wasActive then stopHiddenFling() end
    end

