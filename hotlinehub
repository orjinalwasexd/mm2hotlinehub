            _LS_TweenService:Create(card, TweenInfo.new(0.05), {Position = at(8)}):Play()  task.wait(0.05)
            _LS_TweenService:Create(card, TweenInfo.new(0.05), {Position = at(-8)}):Play() task.wait(0.05)
            _LS_TweenService:Create(card, TweenInfo.new(0.05), {Position = at(6)}):Play()  task.wait(0.05)
            _LS_TweenService:Create(card, TweenInfo.new(0.05), {Position = at(-4)}):Play() task.wait(0.05)
            _LS_TweenService:Create(card, TweenInfo.new(0.08), {Position = at(0)}):Play()
        end

        local function tryKey()
            if keyAccepted then return end
            local inp = textBox.Text:gsub("^%s*(.-)%s*$", "%1"):lower()
            if inp == VALID_KEY then
                keyAccepted = true
                if inputConn then inputConn:Disconnect() end
                statusLabel.TextColor3 = Color3.fromRGB(80, 200, 120)
                statusLabel.Text = "Key accepted"
                _LS_TweenService:Create(cardStroke, TweenInfo.new(0.3), {Color = Color3.fromRGB(80, 200, 120)}):Play()
